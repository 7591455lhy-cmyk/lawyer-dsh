{
  // 编辑器类型辅助：把 @deepseek-ai/cordis 的类型指到 deepseek-harness 源码上。
  // 构建不依赖本文件（esbuild 不做类型检查）；版本号升级后需同步 paths。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "paths": {
      "@deepseek-ai/cordis": [
        "../../../deepseek-harness/vendor/cordis/lib/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
