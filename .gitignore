.env
.env.*
*.key
*.pem

# ===== 日志与临时文件 =====
*.log
logs/
tmp/
*.tmp

# ===== 工具自身的数据 =====
.codebuddy/
.dsh/
.vscode/
.idea/

# ===== 系统垃圾文件 =====
Thumbs.db
.DS_Store
desktop.ini

