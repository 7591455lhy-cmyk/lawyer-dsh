# ===== 依赖目录（最大头，永远不要提交）=====
node_modules/
.pnpm-store/

# ===== 构建产物 =====
dist/
build/
out/
*.tsbuildinfo

# ===== 打包产物（M5 Electron 会生成）=====
release/
*.exe
*.msi
*.nupkg

