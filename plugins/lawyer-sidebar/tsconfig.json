        "../../../deepseek-harness-015/node_modules/.pnpm/@types+react@18.3.31/node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "../../../deepseek-harness-015/node_modules/.pnpm/@types+react@18.3.31/node_modules/@types/react/jsx-runtime"
      ],
      "react-dom": [
        "../../../deepseek-harness-015/node_modules/.pnpm/@types+react-dom@18.3.7_@types+react@18.3.31/node_modules/@types/react-dom"
      ],
      "react-dom/client": [
        "../../../deepseek-harness-015/node_modules/.pnpm/@types+react-dom@18.3.7_@types+react@18.3.31/node_modules/@types/react-dom/client"
      ],
      "@deepseek-ai/cordis": [
        "../../../deepseek-harness-015/vendor/cordis/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-api-session-controller/client": [
        "../../../deepseek-harness-015/packages/api/session-controller/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-layout/client": [
        "../../../deepseek-harness-015/packages/client/ui-layout/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-sidebar/client": [
        "../../../deepseek-harness-015/packages/client/ui-sidebar/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-conversation/client": [
        "../../../deepseek-harness-015/packages/client/ui-conversation/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-primitives": [
        "../../../deepseek-harness-015/packages/client/ui-primitives/src/index.ts"
      ],
      "@deepseek-ai/dsh-api-remotes/client": [
