{
  // 编辑器类型辅助：把 @deepseek-ai/cordis 的类型指到 deepseek-harness 源码上。
  // 构建不依赖本文件（esbuild 不做类型检查）；版本号升级后需同步 paths。
  // 当前指向 dsh 0.1.5-alpha.2 副本 deepseek-harness-015（原目录保持 0.1.1-rc.2
  // 用于回退对比）。
  // 注意两点：
  // ① lib/types 是 build 产物、不在 git 里。新检出的副本必须先构建一次：
  //      cd <harness>; node node_modules/typescript/bin/tsc -b vendor/cordis/tsconfig.json
  //    必须带 -b（build mode）：cordis 依赖 vendor/cosmokit，只跑 -p 会报
  //    TS6305「Output file ... has not been built」。
  // ② 不要图省事指向 src/index.ts——那会让 TS 去编译 cordis 整棵源码树，
  //    连带引入大量与本项目无关的错误。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "paths": {
      "@deepseek-ai/cordis": [
        "../../../deepseek-harness-015/vendor/cordis/lib/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
